#include <winver.h>
#include "../shared/version.h"

101 ICON "assets/padsplit.ico"
1 24 "src/app/padsplit.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION PADSPLIT_VERSION_MAJOR,PADSPLIT_VERSION_MINOR,PADSPLIT_VERSION_PATCH,0
PRODUCTVERSION PADSPLIT_VERSION_MAJOR,PADSPLIT_VERSION_MINOR,PADSPLIT_VERSION_PATCH,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "PadSplit Contributors"
            VALUE "FileDescription",  "PadSplit - Dual-Monitor Gamepad & Free Mouse/KB Controller"
            VALUE "FileVersion",      PADSPLIT_VERSION_STR
            VALUE "InternalName",     "PadSplit"
            VALUE "LegalCopyright",   "MIT License"
            VALUE "OriginalFilename", "PadSplit.exe"
            VALUE "ProductName",      "PadSplit"
            VALUE "ProductVersion",   PADSPLIT_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
